{
  "id": null,
  "uid": "cassandra-response-time-replay",
  "title": "Cassandra response time — replay",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "timezone": "Europe/Moscow",
  "refresh": "",
