# Optional overrides for docker-compose-service.yml (copy to infra/service.env).
ATROPOS_CONFIG_DB=atropos_config
ATROPOS_CONFIG_USER=atropos
ATROPOS_CONFIG_PASSWORD=atropos-local-config
ATROPOS_CONFIG_PORT=55432
ATROPOS_SERVER_PORT=8000
ATROPOS_UI_PORT=8501
ATROPOS_SERVER_MEMORY=2g
ATROPOS_UI_MEMORY=1g
# Export this DSN in the UI/backend process if overriding the defaults above.
# Compose --env-file does not set variables in the host PowerShell process.
ATROPOS_CONFIG_DATABASE_URL=postgresql://atropos:atropos-local-config@127.0.0.1:55432/atropos_config
