# Optional environment for BOTH UI and server. Copy to infra/runtime.env.
# Put source credentials here using the variable names stored in datasource settings.
# INFLUXDB_TOKEN=...
# VM_TOKEN=...
# CLICKHOUSE_PASSWORD=...
# Optional legacy operator login (existing PostgreSQL accounts work without these):
# ATROPOS_UI_USERNAME=admin
# ATROPOS_UI_PASSWORD_HASH=pbkdf2_sha256$600000$...
# Budgets from docs/REMEDIATION.md can also be set here.
# Do not copy the host PostgreSQL DSN here: containers use PGHOST=config-postgres.
