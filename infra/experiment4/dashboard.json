    {
      "id": 10,
      "type": "timeseries",
      "title": "09 · CPU и throttling контейнера",
      "description": "Process CPU измерен MXBean JVM: 0–1 доля доступной процессу мощности. cgroup.cpu.stat дополнительно измеряет throttled seconds/s. cAdvisor показывает использованные ядра / limit4 и долю throttled periods; эти серии доступны, если Docker Desktop их экспортирует. Сильное throttling или saturation загрязняют опыт.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "100 * exp4_process_cpu_usage{experiment=\"experiment4\",service=\"java\"}",
          "legendFormat": "JVM process CPU %",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"atropos-experiment4\",container_label_com_docker_compose_service=\"java\"}[60s])) / 4",
          "legendFormat": "container CPU / 4 cores %",
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
