        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          },
          "expr": "sum(rate(exp4_allocated_bytes_total{experiment=\"experiment4\",service=\"java\"}[60s])) / 1048576",
          "legendFormat": "observed MiB/s",
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
