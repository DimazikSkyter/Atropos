        },
        {
          "refId": "B",
          "expr": "sum(rate(lab_events_total{stage=\"db_retry\"}[20s]))",
          "legendFormat": "DB retries"
        },
        {
          "refId": "C",
          "expr": "lab_kafka_probe_ok",
          "legendFormat": "Kafka probe available"
        },
        {
          "refId": "D",
          "expr": "min(up{job=\"experiment-app\"})",
          "legendFormat": "all app metrics available"
        }
