        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "experiment"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"atropos-experiment\",image!=\"\"}[20s]))",
