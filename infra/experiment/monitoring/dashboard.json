    {
      "id": 12,
      "title": "12 \u00b7 Errors / retries and observation availability",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "experiment"
      },
      "targets": [
        {
          "refId": "A",
