    {
      "id": 11,
      "title": "11 \u00b7 Actual blocked Kafka file operations",
      "type": "timeseries",
      "description": "Test 1 is rejected if no actual write/flush calls enter the gate. The JVM is not paused.",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "experiment"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_disk_blocked_calls",
          "legendFormat": "currently blocked"
        },
        {
          "refId": "B",
          "expr": "increase(lab_disk_gate_entries_total[20s])",
          "legendFormat": "entered gate / 20s"
        }
      ],
      "fieldConfig": {
