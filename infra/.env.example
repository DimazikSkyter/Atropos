POSTGRES_DB=atropos
POSTGRES_USER=atropos
POSTGRES_PASSWORD=atropos
POSTGRES_PORT=5432

KAFKA_PORT=9092
KAFKA_TOPIC=cart-purchases
KAFKA_TOPIC_PARTITIONS=3

VICTORIA_METRICS_PORT=8428
# Absolute host path; use forward slashes on Windows.
VM_DATA_PATH=F:/vm_data
VM_RETENTION_PERIOD=100y

GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Historical metric replay (InfluxDB v2, persistent volumes, one-year retention).
INFLUXDB_PORT=8086
INFLUXDB_USER=atropos
INFLUXDB_PASSWORD=atropos-influxdb
INFLUXDB_ORG=atropos
INFLUXDB_BUCKET=metrics-replay
INFLUXDB_RETENTION=365d
INFLUXDB_TOKEN=atropos-local-replay-token
