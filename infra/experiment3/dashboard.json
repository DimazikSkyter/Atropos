        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(exp3_processing_seconds_sum{service=\"service2\"}[10s]) / rate(exp3_processing_seconds_count{service=\"service2\"}[10s])",
          "legendFormat": "mean",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, rate(exp3_processing_seconds_bucket{service=\"service2\"}[10s]))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          }
        },
        {
          "refId": "C",
          "expr": "0 * exp3_degraded{service=\"service2\"} + 0.05",
          "legendFormat": "timeout 50 ms",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
