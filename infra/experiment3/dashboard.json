      "title": "04 · Усиление нагрузки на сервис 2",
      "description": "Когда пул насыщен, новые попытки остаются в очереди: фактическое усиление ограничено пропускной способностью пула.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(exp3_attempts_total{service=\"service1\"}[10s]) / rate(exp3_received_total{service=\"service1\"}[10s])) and (rate(exp3_received_total{service=\"service1\"}[10s]) > 100)",
          "legendFormat": "attempts / input",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          }
        },
        {
          "refId": "B",
          "expr": "rate(exp3_retries_total{service=\"service1\"}[10s]) / clamp_min(rate(exp3_attempts_total{service=\"service1\"}[10s]), 1)",
          "legendFormat": "retry share",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
