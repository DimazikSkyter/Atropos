  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "01 · Постоянная нагрузка: 750 RPS",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoria-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total{experiment=\"experiment3\",name=\"submit\"}[10s]))",
          "legendFormat": "k6 sent",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          }
        },
        {
          "refId": "B",
          "expr": "rate(exp3_received_total{service=\"service1\"}[10s])",
          "legendFormat": "service1 accepted",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rate(k6_exp3_load_refused_total{experiment=\"experiment3\"}[10s]))",
          "legendFormat": "k6 refused after OOM",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          }
        },
        {
          "refId": "D",
          "expr": "sum(rate(k6_dropped_iterations_total{experiment=\"experiment3\"}[10s]))",
          "legendFormat": "k6 dropped iterations",
          "datasource": {
            "type": "prometheus",
            "uid": "victoria-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "02 · Деградация сервиса 2: 30–40 → 40–60 ms",
      "description": "Задержка работы сервиса 2. Deadline сервиса 1 включает HTTP submission и ожидание callback.",
