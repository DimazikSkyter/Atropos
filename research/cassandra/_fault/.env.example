CASSANDRA_IMAGE=cassandra:4.1.12
JMX_EXPORTER_VERSION=1.6.0
VICTORIAMETRICS_IMAGE=victoriametrics/victoria-metrics:v1.144.0
GRAFANA_IMAGE=grafana/grafana:13.0.8
GRAFANA_PORT=33000
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.2
CADVISOR_PORT=38080
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.11.1

# Deliberately too slow for the generated workload.
COMPACTION_MIB=1
CONCURRENT_COMPACTORS=1

LOAD_DURATION=30m
LOAD_THREADS=48
WRITE_WEIGHT=8
READ_WEIGHT=2

# Compact metrics snapshot interval in each Cassandra container log.
LAB_REPORT_INTERVAL=15

# Used only when scripts/start.ps1 launches the portable Windows exporter.
WINDOWS_EXPORTER_VERSION=0.31.7
